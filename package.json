{
  "name": "purgewave",
  "version": "0.1.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:local": "electron-vite build && electron-builder --win --dir && rm -f PurgeWave-win.zip && cd release/win-unpacked && zip -r -q ../../PurgeWave-win.zip . && cd ../.. && echo 'Built PurgeWave-win.zip in the project root.'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A Windows desktop app for triaging a local music library one track at a time.",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.0",
    "music-metadata": "^11.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  }
}
